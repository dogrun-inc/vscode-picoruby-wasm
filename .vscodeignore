# Ignore files and directories for VS Code extension development
.vscode/**
.vscode-test/**
.gitignore
.yarnrc
**/.vscode-test.*

# Source files
src/**
**/tsconfig.json
**/eslint.config.mjs
**/*.ts

# PicoRuby artifacts
**/*.br
**/*.map

# memo and logs
vsc-extension-quickstart.md
history_of_development.md
*-memo.md
**/*.log

# Ruby development environment artifacts
.ruby-lsp/**

# Release artifacts
releases/**
**/*.vsix
**/*.vsix.sha256

# Sample (not required for extension execution)
sample/**

# Compiled tests
out/test/**

# Stale development build artifacts
out/**/* copy.js
